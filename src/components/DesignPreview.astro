---
// Nur in der lokalen Vorschau (npm run dev) sichtbar – wird nicht veröffentlicht.
// Zum Ausprobieren von Schriften und Akzentfarben. Nach der Entscheidung wieder entfernen.
const fonts = [
  { id: 'a', label: 'A · Kinoplakat', hint: 'Bebas Neue + Inter' },
  { id: 'b', label: 'B · Festival', hint: 'Instrument Serif + Inter' },
  { id: 'c', label: 'C · Timecode', hint: 'Space Grotesk + JetBrains Mono' },
];
const colors = [
  { id: 'tungsten', label: 'Tungsten', value: '#f2a43a' },
  { id: 'tally', label: 'Tally-Rot', value: '#ff5a4f' },
  { id: 'blau', label: 'Blaue Stunde', value: '#6ec1ff' },
  { id: 'green', label: 'Greenscreen', value: '#a6e35c' },
  { id: 'mono', label: 'Monochrom', value: '#ebe7e0' },
];
---

<script is:inline define:vars={{ colors }}>
  // Vor dem ersten Zeichnen anwenden, damit nichts flackert
  try {
    const s = JSON.parse(localStorage.getItem('design-preview') || '{}');
    if (s.font) document.documentElement.dataset.font = s.font;
    const c = colors.find((c) => c.id === s.color);
    if (c) document.documentElement.style.setProperty('--accent', c.value);
  } catch {}
</script>

<aside class="dp" aria-label="Design-Vorschau">
  <button type="button" class="dp__toggle">Design-Vorschau</button>
  <div class="dp__panel" hidden>
    <p class="dp__label">Schrift</p>
    <div class="dp__row">
      {fonts.map((f) => <button type="button" class="dp__font" data-font={f.id} title={f.hint}>{f.label}</button>)}
    </div>
    <p class="dp__label">Akzentfarbe</p>
    <div class="dp__row">
      {
        colors.map((c) => (
          <button type="button" class="dp__color" data-color={c.id} data-value={c.value} title={c.label} style={`--c:${c.value}`}>
            <span>{c.label}</span>
          </button>
        ))
      }
    </div>
    <p class="dp__note">Nur lokal sichtbar · gilt für alle Seiten</p>
  </div>
</aside>

<script>
  const root = document.documentElement;
  const panel = document.querySelector<HTMLElement>('.dp__panel')!;
  const load = () => JSON.parse(localStorage.getItem('design-preview') || '{}');
  const save = (patch: object) => localStorage.setItem('design-preview', JSON.stringify({ ...load(), ...patch }));

  const fontLoaders: Record<string, () => Promise<unknown>> = {
    b: () => import('@fontsource/instrument-serif'),
    c: () => Promise.all([import('@fontsource-variable/space-grotesk'), import('@fontsource-variable/jetbrains-mono')]),
  };

  function setFont(id: string) {
    fontLoaders[id]?.();
    if (id === 'a') delete root.dataset.font;
    else root.dataset.font = id;
    document.querySelectorAll<HTMLElement>('.dp__font').forEach((b) => b.classList.toggle('is-on', b.dataset.font === id));
  }

  function setColor(id: string, value: string) {
    root.style.setProperty('--accent', value);
    document.querySelectorAll<HTMLElement>('.dp__color').forEach((b) => b.classList.toggle('is-on', b.dataset.color === id));
  }

  document.querySelector('.dp__toggle')!.addEventListener('click', () => (panel.hidden = !panel.hidden));
  document.querySelectorAll<HTMLElement>('.dp__font').forEach((b) =>
    b.addEventListener('click', () => {
      setFont(b.dataset.font!);
      save({ font: b.dataset.font });
    }),
  );
  document.querySelectorAll<HTMLElement>('.dp__color').forEach((b) =>
    b.addEventListener('click', () => {
      setColor(b.dataset.color!, b.dataset.value!);
      save({ color: b.dataset.color });
    }),
  );

  const s = load();
  setFont(s.font ?? 'a');
  const c = document.querySelector<HTMLElement>(`.dp__color[data-color="${s.color ?? 'tungsten'}"]`);
  if (c) setColor(c.dataset.color!, c.dataset.value!);
</script>

<style is:global>
  /* B · Festival: elegante Serifenschrift, wie ein Filmfestival-Programm */
  html[data-font='b'] {
    --font-display: 'Instrument Serif', Georgia, serif;
    --ds: 0.95;
    --display-tracking: -0.01em;
    --display-lh: 0.92;
  }

  /* C · Timecode: technisch-modern, Labels in Monospace wie ein Timecode-Display */
  html[data-font='c'] {
    --font-display: 'Space Grotesk Variable', system-ui, sans-serif;
    --font-label: 'JetBrains Mono Variable', ui-monospace, monospace;
    --ds: 0.72;
    --display-weight: 600;
    --display-tracking: -0.035em;
    --display-lh: 0.95;
  }
</style>

<style>
  .dp {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 200;
    font-family: 'Inter Variable', system-ui, sans-serif;
    font-size: 0.8rem;
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .dp__toggle {
    font: inherit;
    font-weight: 600;
    background: #ebe7e0;
    color: #111;
    border: 0;
    border-radius: 999px;
    padding: 0.6em 1.1em;
    cursor: pointer;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.5);
  }

  .dp__panel {
    width: min(20rem, calc(100vw - 2rem));
    background: #18181b;
    border: 1px solid #333;
    border-radius: 12px;
    padding: 0.9rem;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
  }

  .dp__label {
    margin: 0 0 0.4rem;
    color: #8d8a84;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 0.65rem;
  }

  .dp__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.9rem;
  }

  .dp__font, .dp__color {
    font: inherit;
    color: #ebe7e0;
    background: transparent;
    border: 1px solid #333;
    border-radius: 999px;
    padding: 0.35em 0.75em;
    cursor: pointer;
  }

  .dp__color { display: inline-flex; align-items: center; gap: 0.4em; }
  .dp__color::before { content: ''; width: 0.8em; height: 0.8em; border-radius: 50%; background: var(--c); }
  .dp__font.is-on, .dp__color.is-on { border-color: #ebe7e0; background: #2a2a2e; }

  .dp__note { margin: 0; color: #8d8a84; font-size: 0.7rem; }
</style>
