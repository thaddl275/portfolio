---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { CATEGORIES } from '../../content.config';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[i - 1] ?? projects[projects.length - 1],
      next: projects[i + 1] ?? projects[0],
    },
  }));
}

const { project, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

// Große Versionen für die Lightbox
const gallery = await Promise.all(
  data.gallery.map(async (src) => ({
    src,
    full: (await getImage({ src, width: Math.min(src.width, 2000) })).src,
  })),
);
const plainText = project.body?.replace(/\s+/g, ' ').trim().slice(0, 155);
---

<Base title={data.title} description={plainText}>
  <article>
    <header class="head">
      <div class="head__media">
        <Image src={data.cover} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" class="head__img" />
        <div class="head__shade"></div>
      </div>
      <div class="wrap head__content">
        <a href={`/#${data.category}`} class="eyebrow eyebrow--accent head__cat">{CATEGORIES[data.category]}</a>
        <h1 class="head__title">{data.title}</h1>
      </div>
    </header>

    <div class="wrap body">
      <dl class="facts">
        <div><dt>Rolle</dt><dd>{data.role}</dd></div>
        {data.year && <div><dt>Jahr</dt><dd>{data.year}</dd></div>}
        {data.location && <div><dt>Ort</dt><dd>{data.location}</dd></div>}
      </dl>

      <div class="text">
        <Content />
        {
          data.links.length > 0 && (
            <div class="links">
              {data.links.map((l) => (
                <a class="btn" href={l.url} target="_blank" rel="noopener">
                  {l.label} ↗
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>

    {
      gallery.length > 0 && (
        <section class="wrap gallery" aria-label="Bildergalerie">
          {gallery.map((g, i) => (
            <a href={g.full} class="gallery__item" data-index={i}>
              <Image src={g.src} alt={`${data.title} – Bild ${i + 1}`} widths={[600, 1000, 1400]} sizes="(max-width: 700px) 100vw, 50vw" />
            </a>
          ))}
          {data.credits && <p class="gallery__credits">{data.credits}</p>}
        </section>
      )
    }

    <nav class="wrap pager" aria-label="Weitere Projekte">
      <a href={`/projekte/${prev.id}/`} class="pager__link">
        <span class="eyebrow">← Vorheriges</span>
        <span class="pager__title">{prev.data.title}</span>
      </a>
      <a href={`/projekte/${next.id}/`} class="pager__link pager__link--next">
        <span class="eyebrow">Nächstes →</span>
        <span class="pager__title">{next.data.title}</span>
      </a>
    </nav>
  </article>

  <dialog class="lightbox" aria-label="Bildansicht">
    <img class="lightbox__img" alt="" />
    <button type="button" class="lightbox__btn lightbox__close" aria-label="Schließen">✕</button>
    <button type="button" class="lightbox__btn lightbox__prev" aria-label="Vorheriges Bild">‹</button>
    <button type="button" class="lightbox__btn lightbox__next" aria-label="Nächstes Bild">›</button>
    <p class="lightbox__count"></p>
  </dialog>
</Base>

<script>
  const items = [...document.querySelectorAll<HTMLAnchorElement>('.gallery__item')];
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
  const count = dialog.querySelector<HTMLElement>('.lightbox__count')!;
  let current = 0;

  function show(i: number) {
    current = (i + items.length) % items.length;
    img.src = items[current].href;
    img.alt = items[current].querySelector('img')?.alt ?? '';
    count.textContent = `${current + 1} / ${items.length}`;
  }

  items.forEach((item, i) =>
    item.addEventListener('click', (e) => {
      e.preventDefault();
      show(i);
      dialog.showModal();
    }),
  );

  const single = items.length < 2;
  dialog.querySelector<HTMLElement>('.lightbox__prev')!.hidden = single;
  dialog.querySelector<HTMLElement>('.lightbox__next')!.hidden = single;

  dialog.querySelector('.lightbox__close')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.lightbox__prev')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('.lightbox__next')!.addEventListener('click', () => show(current + 1));
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });

  // Wischen auf dem Handy
  let startX = 0;
  dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
  dialog.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
  });
</script>

<style>
  .head {
    position: relative;
    min-height: min(75vh, 760px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .head__media, .head__shade { position: absolute; inset: 0; }

  .head__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) brightness(0.75);
  }

  .head__shade {
    background: linear-gradient(to top, var(--bg) 0%, rgba(10, 10, 11, 0.5) 45%, rgba(10, 10, 11, 0.1) 100%);
  }

  .head__content {
    position: relative;
    width: 100%;
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .head__cat { text-decoration: none; }
  .head__cat:hover { text-decoration: underline; }

  .head__title {
    font-size: calc(var(--ds) * clamp(3rem, 10vw, 8rem));
    margin-top: 0.75rem;
    max-width: 14ch;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .facts { margin: 0; display: grid; gap: 1.25rem; align-content: start; }
  .facts div { border-top: 1px solid var(--line); padding-top: 0.75rem; }
  .facts dt { font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
  .facts dd { margin: 0.2rem 0 0; }

  .text { font-size: clamp(1.05rem, 1.8vw, 1.3rem); font-weight: 300; line-height: 1.6; max-width: 44rem; }
  .text :global(p) { margin: 0 0 1em; }

  .links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; font-weight: 400; }

  .gallery {
    columns: 2 320px;
    column-gap: 1rem;
  }

  .gallery__item {
    display: block;
    margin-bottom: 1rem;
    break-inside: avoid;
    overflow: hidden;
    border-radius: 4px;
    cursor: zoom-in;
    background: var(--bg-raised);
  }

  .gallery__item :global(img) {
    width: 100%;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.4s;
    filter: brightness(0.92);
  }

  .gallery__item:hover :global(img) { transform: scale(1.025); filter: brightness(1); }

  .gallery__credits { font-size: 0.85rem; color: var(--muted); margin: 0.25rem 0 0; }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: clamp(3rem, 8vw, 6rem);
  }

  .pager__link {
    display: grid;
    gap: 0.4rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }

  .pager__link--next { text-align: right; }

  .pager__title {
    font-family: var(--font-display);
    font-size: calc(var(--ds) * clamp(1.5rem, 3.5vw, 2.6rem));
    line-height: 1;
    transition: color 0.2s;
  }

  .pager__link:hover .pager__title { color: var(--accent); }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(5, 5, 6, 0.96);
    color: var(--text);
  }

  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: transparent; }

  .lightbox__img {
    max-width: 92vw;
    max-height: 86vh;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .lightbox__btn {
    position: absolute;
    background: none;
    border: 0;
    color: var(--text);
    font-size: 2.5rem;
    line-height: 1;
    padding: 1rem;
    cursor: pointer;
    opacity: 0.7;
  }

  .lightbox__btn:hover { opacity: 1; color: var(--accent); }
  .lightbox__close { top: 0.5rem; right: 0.75rem; font-size: 1.6rem; }
  .lightbox__prev { left: 0.5rem; top: 50%; transform: translateY(-50%); }
  .lightbox__next { right: 0.5rem; top: 50%; transform: translateY(-50%); }

  .lightbox__count {
    position: absolute;
    bottom: 1rem;
    left: 0;
    right: 0;
    margin: 0;
    text-align: center;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .body { grid-template-columns: 1fr; }
    .facts { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
  }
</style>
